# Base padrão: demonstração pública QuickPizza.
BASE_URL=https://quickpizza.grafana.com

# Credenciais disponíveis na imagem local de demonstração.
# No host público, configure somente credenciais que você controla.
QP_USERNAME=
QP_PASSWORD=

# Ratings alteram dados; mantenha false no host público.
QP_ENABLE_RATING=false

# Carga padrão segura. Valores maiores são limitados pelo código.
VUS=5
DURATION=2m
PROFILE=smoke
ENABLE_HIGH_LOAD=false
K6_BROWSER_HEADLESS=true